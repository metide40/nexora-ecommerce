# Copy this file to .env and fill in your values
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=nexora
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Set to 1 to skip PostgreSQL and use a local SQLite file instead (quick testing)
USE_SQLITE=0
